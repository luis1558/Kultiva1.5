
# AREA
CREATE TABLE area (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  area TEXT NOT NULL
);

## CARGO
CREATE TABLE cargo (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  cargo TEXT NOT NULL,
  areaid INTEGER,
  FOREIGN KEY (areaid) REFERENCES area(id)
);

## DIMENSIONES
CREATE TABLE dimensiones (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    dimensiones TEXT NOT NULL
, sugerencia_1 TEXT, sugerencia_2 TEXT, sugerencia_3 TEXT, sugerencia_4TEXT, sugerencia_5TEXT);

## EMPLEADOS
CREATE TABLE empleados (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  nombre TEXT NOT NULL,
  correo TEXT NOT NULL UNIQUE,
  contraseña TEXT NOT NULL,
  cargoid INTEGER, cedula NUMERIC, genero TEXT CHECK (genero IN ('m', 'f')), fecha_nacimiento DATE, fecha_ingreso DATE, razon_social TEXT, ciudad TEXT, sede TEXT, nivel_jerarquico TEXT, encuesta TEXT, correo_enviado_plan BOOLEAN DEFAULT FALSE,
  FOREIGN KEY (cargoid) REFERENCES cargo(id)
);

## JEFE_EMPLEADO
CREATE TABLE jefe_empleado (
  empleado_id INTEGER,
  jefe_id INTEGER,
  PRIMARY KEY (empleado_id, jefe_id),
  FOREIGN KEY (empleado_id) REFERENCES empleados(id),
  FOREIGN KEY (jefe_id) REFERENCES empleados(id)
);

# ROLES
CREATE TABLE roles (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  nombre TEXT UNIQUE NOT NULL
);

# ROL_EMPLEADO
CREATE TABLE rol_empleado (
  empleado_id INTEGER,
  rol_id INTEGER,
  PRIMARY KEY (empleado_id, rol_id),
  FOREIGN KEY (empleado_id) REFERENCES empleados(id),
  FOREIGN KEY (rol_id) REFERENCES roles(id)
);

## PASSWORD_RESETS
CREATE TABLE password_resets (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    correo TEXT NOT NULL,
    token TEXT NOT NULL UNIQUE,
    expires_at INTEGER NOT NULL,
    used BOOLEAN DEFAULT FALSE,
    created_at INTEGER DEFAULT (strftime('%s', 'now'))
);

## PLANES_DE_ACCION
CREATE TABLE planes_de_accion (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    empleado_id INTEGER NOT NULL,
    dimension_id INTEGER NOT NULL,
    sugerencia_1 TEXT,
    sugerencia_2 TEXT,
    periodo_inicial_1 DATE,
    periodo_final_1 DATE,
    periodo_inicial_2 DATE,
    periodo_final_2 DATE,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    fecha_actualizacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (empleado_id) REFERENCES empleados(id),
    FOREIGN KEY (dimension_id) REFERENCES dimensiones(id)
);

## PLANES_DE_ACCION_GERENCIA
CREATE TABLE planes_de_accion_gerencia (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    dimension_id INTEGER NOT NULL,
    sugerencia_1 TEXT,
    sugerencia_2 TEXT,
    periodo_inicial_1 DATE,
    periodo_final_1 DATE,
    periodo_inicial_2 DATE,
    periodo_final_2 DATE,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    fecha_actualizacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (dimension_id) REFERENCES dimensiones(id)
);

## PREGUNTAS_ENCUESTA
CREATE TABLE "preguntas_encuesta" (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    pregunta TEXT NOT NULL,
    dimension_id INTEGER,
    FOREIGN KEY (dimension_id) REFERENCES dimensiones(id)
);

## RESPUESTAS_ENCUESTA
CREATE TABLE respuestas_encuesta (
id INTEGER PRIMARY KEY AUTOINCREMENT,
jefe_id INTEGER NOT NULL,
empleado_id INTEGER NOT NULL,
pregunta_id INTEGER NOT NULL,
respuesta REAL NOT NULL,  -- Cambié el tipo de INTEGER a REAL
UNIQUE (jefe_id, empleado_id, pregunta_id),
FOREIGN KEY (jefe_id, empleado_id) REFERENCES jefe_empleado(jefe_id, empleado_id),
FOREIGN KEY (pregunta_id) REFERENCES preguntas_encuesta(id)
);

## SUGERENCIAS_GERENCIAS
CREATE TABLE sugerencias_gerencias (
    id INTEGER PRIMARY KEY,
    dimensiones TEXT,
    sugerencia_1 TEXT,
    sugerencia_2 TEXT,
    sugerencia_3 TEXT,
    sugerencia_4 TEXT,
    sugerencia_5 TEXT,
    sugerencia_6 TEXT,
    sugerencia_7 TEXT,
    sugerencia_8 TEXT,
    sugerencia_9 TEXT,
    sugerencia_10 TEXT,
    sugerencia_11 TEXT,
    sugerencia_12 TEXT);

## VW_BASE_RESPUESTAS
CREATE VIEW vw_base_respuestas AS
  SELECT
    e1.cedula,
    e1.nombre AS empleado,
    c.cargo,
    a.area,
    e2.nombre AS jefe,
    pe.pregunta,
    d.dimensiones,
    re.respuesta
FROM respuestas_encuesta re
JOIN empleados e1 ON re.empleado_id = e1.id
JOIN empleados e2 ON re.jefe_id = e2.id
JOIN cargo c ON e1.cargoid = c.id
JOIN area a ON c.areaid = a.id
JOIN preguntas_encuesta pe ON re.pregunta_id = pe.id
JOIN dimensiones d ON pe.dimension_id = d.id

