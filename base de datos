## VW_PROMEDIO_RESPUESTAS_POR_JEFE
CREATE VIEW vw_promedio_respuestas_por_jefe AS
SELECT
    e2.id AS id,  -- ID del jefe
    e2.nombre AS jefe,
    d.dimensiones,
    ROUND(AVG(re.respuesta) * 100) AS promedio_respuesta  -- Redondea al número entero más cercano
FROM respuestas_encuesta re
JOIN empleados e1 ON re.empleado_id = e1.id
JOIN empleados e2 ON re.jefe_id = e2.id
JOIN cargo c ON e1.cargoid = c.id
JOIN area a ON c.areaid = a.id
JOIN preguntas_encuesta pe ON re.pregunta_id = pe.id
JOIN dimensiones d ON pe.dimension_id = d.id
WHERE d.dimensiones != 'Preguntas Abiertas'  -- Excluir la dimensión 13
GROUP BY e2.id, e2.nombre, d.dimensiones

## VW_RESUMEN_PLAN_DE_ACCION
CREATE VIEW vw_resumen_plan_de_accion as
SELECT
  e2.id AS id,
  -- ID del jefe
  e2.nombre AS jefe,
  d.dimensiones,
  AVG(re.respuesta) * 100 AS promedio_respuesta,
  pda.sugerencia_1,
  pda.sugerencia_2,
  pda.periodo_inicial_1,
  pda.periodo_final_1,
  pda.periodo_inicial_2,
  pda.periodo_final_2
FROM
  respuestas_encuesta re
  JOIN empleados e1 ON re.empleado_id = e1.id
  JOIN empleados e2 ON re.jefe_id = e2.id
  JOIN cargo c ON e1.cargoid = c.id
  JOIN area a ON c.areaid = a.id
  JOIN preguntas_encuesta pe ON re.pregunta_id = pe.id
  JOIN dimensiones d ON pe.dimension_id = d.id
  JOIN planes_de_accion pda ON pda.empleado_id = e2.id
  AND pda.dimension_id = d.id
WHERE
  d.dimensiones != 'Preguntas Abiertas'
GROUP BY
  e2.id,
  e2.nombre,
  d.dimensiones,
  pda.sugerencia_1,
  pda.sugerencia_2

## VW_RESUMEN_PLAN_DE_ACCION_GENERAL
CREATE VIEW vw_resumen_plan_de_accion_general AS
SELECT
    v.dimensiones,
    v.promedio,
    p.sugerencia_1 AS "Accion de mejora 1",
    p.sugerencia_2 AS "Accion de mejora 2",
    p.periodo_inicial_1 AS "Periodo Inicial 1",
    p.periodo_final_1 AS "Periodo Final 1",
    p.periodo_inicial_2 AS "Periodo Inicial 2",
    p.periodo_final_2 AS "Periodo Final 2"
FROM
    vw_promedio_respuestas_general v
JOIN
    planes_de_accion_gerencia p
ON
    v.id = p.dimension_id

## VW_RESUMEN_PLANES_LIDER
CREATE VIEW vw_resumen_planes_lider AS
SELECT
    e.id,
    e.cedula,
    e.nombre,
    COALESCE(dimensiones.count, 0) AS dimensiones,
    COALESCE(planes.count, 0) AS planes
FROM empleados e
LEFT JOIN (
    SELECT id, COUNT(*) AS count
    FROM vw_promedio_respuestas_por_jefe
    WHERE promedio_respuesta <= 74
    GROUP BY id
) dimensiones ON e.id = dimensiones.id
LEFT JOIN (
    SELECT empleado_id, COUNT(*) AS count
    FROM planes_de_accion
    GROUP BY empleado_id
) planes ON e.id = planes.empleado_id

