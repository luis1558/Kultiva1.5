## VW_PROMEDIO_RESPUESTAS_GENERAL
CREATE VIEW vw_promedio_respuestas_general AS
SELECT
        d.id AS id,
        d.dimensiones AS dimensiones,
        ROUND(
            (
                (COALESCE(AVG(CASE WHEN d.id = 1 THEN v."D1-1" END), 0)) +
                (COALESCE(AVG(CASE WHEN d.id = 1 THEN v."D1-2" END), 0)) +
                (COALESCE(AVG(CASE WHEN d.id = 1 THEN v."D1-3" END), 0)) +
                (COALESCE(AVG(CASE WHEN d.id = 1 THEN v."D1-4" END), 0)) +
                (COALESCE(AVG(CASE WHEN d.id = 1 THEN v."D1-5" END), 0))
            ) / 5 * 100
        ) AS promedio
    FROM
        dimensiones d
    LEFT JOIN
        vw_base_respuestas_yudi v
        ON d.id = 1
    WHERE
        d.id = 1
    GROUP BY
        d.id, d.dimensiones

